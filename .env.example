# Lấy ở Stripe Dashboard > Developers > API keys (dùng khóa bắt đầu sk_test_,
# KHÔNG dùng khóa live trong suốt quá trình làm đồ án)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""